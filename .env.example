# Deployment only: no credentials are needed for local review or tests.
# Build-time launch switch: only the exact value true enables the product.
# Set true in Vercel Preview only; leave Production unset until closing.
SHOW_MEDICALGERMAN=false
# Leave disabled until the checklist in README.md is complete.
# Set NODE_ENV=production in Vercel production config; local servers ignore mail config.
# Required server configuration: preserve the raw request for the byte-size limit.
NODEJS_HELPERS=0
CONTACT_FORM_ENABLED=false
CONTACT_SENDER_VERIFIED=false
CONTACT_EMAIL_AUTH_VERIFIED=false
CONTACT_LOG_RETENTION_REVIEWED=false
# Preferred: authenticate Greg's existing user; From stays the verified website@ alias.
GOOGLE_WORKSPACE_USER=
# App password created on that user, named/used only for the website, if policy permits.
# Manual alias authentication is verified by Greg; keep template flags disabled.
# Enable only during authorised production testing after credentials/rate limits/review.
GOOGLE_WORKSPACE_APP_PASSWORD=
# Random server-side secret (32+ characters); production Vercel Secret type only.
CONTACT_RATE_LIMIT_KEY_SECRET=

# Optional analytics: configure only after provider setup and privacy approval.
# Preview and local builds always disable collection. No API secret is needed.
ANALYTICS_ENABLED=false
PLAUSIBLE_DOMAIN=
